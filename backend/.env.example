# Anthropic / Claude AI
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database — PostgreSQL (use Supabase or local)
DATABASE_URL=postgresql://user:password@localhost:5432/projectmarcy

# Redis — for real-time rooms and caching
REDIS_URL=redis://localhost:6379

# Auth — generate a strong random secret (e.g. openssl rand -hex 32)
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# CORS — frontend origin
FRONTEND_URL=http://localhost:3000

# Music integration (optional — Spotify OAuth)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# File uploads (optional — S3-compatible for meme/image storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
